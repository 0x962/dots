{
	"version": 1,
	"name": "review",
	"root": "review",
	"nodes": {
		"review": {
			"kind": "sequence",
			"title": "Review",
			"children": [
				"summarize",
				"fanout"
			]
		},
		"summarize": {
			"kind": "agent",
			"title": "Summarize the change",
			"children": []
		},
		"fanout": {
			"kind": "parallel",
			"title": "At the same time",
			"children": [
				"frontend",
				"backend",
				"readability"
			]
		},
		"frontend": {
			"kind": "gate",
			"title": "Frontend relevant?",
			"children": [
				"shared-components",
				"design-tokens",
				"render-cost"
			]
		},
		"backend": {
			"kind": "gate",
			"title": "Backend relevant?",
			"children": [
				"backend-budget"
			]
		},
		"backend-budget": {
			"kind": "budget",
			"title": "Backend budget",
			"children": [
				"backend-checks"
			],
			"minutes": 12
		},
		"backend-checks": {
			"kind": "parallel",
			"title": "Backend checks",
			"children": [
				"migrations",
				"no-fallbacks",
				"thin-views-and-models",
				"service-boundaries",
				"rest-api",
				"module-layout"
			]
		},
		"readability": {
			"kind": "gate",
			"title": "Readability relevant?",
			"children": [
				"code-comments",
				"naming",
				"dead-code",
				"file-size"
			],
			"elseChildren": []
		},
		"shared-components": {
			"kind": "agent",
			"title": "Shared components",
			"children": []
		},
		"design-tokens": {
			"kind": "agent",
			"title": "Design tokens",
			"children": []
		},
		"render-cost": {
			"kind": "agent",
			"title": "Render cost",
			"children": []
		},
		"no-fallbacks": {
			"kind": "agent",
			"title": "No fallbacks",
			"children": []
		},
		"thin-views-and-models": {
			"kind": "agent",
			"title": "Thin views and models",
			"children": []
		},
		"service-boundaries": {
			"kind": "agent",
			"title": "Service boundaries",
			"children": []
		},
		"rest-api": {
			"kind": "agent",
			"title": "REST API",
			"children": []
